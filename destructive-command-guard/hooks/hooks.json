{
  "description": "destructive-command-guard: blocks or confirms destructive shell commands",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python)\" \"${CLAUDE_PLUGIN_ROOT}/hooks/destructive_guard.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
